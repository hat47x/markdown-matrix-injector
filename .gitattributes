*.sh text eol=lf

# Preserve CP932 bytes and Excel-style CRLF in this sample.
04_Documentation/samples/practical/data/excel-cp932.csv -text -diff

# Base64-encoded binary XLSX payloads: byte-exact ASCII, not line-oriented
# text. Without this, a checkout with core.autocrlf=true rewrites the LF
# line-wrapping to CRLF, corrupting the encoded payload and breaking any test
# that decodes it back to bytes (confirmed 2026-09-23: git blob hash != working
# tree hash for these two files on a Windows checkout with autocrlf=true).
*.xlsx.base64 binary
03_Implement/test/fixtures/*.xlsx binary
# Fixtures whose bytes are hashed (cross-repo identity): keep LF on every checkout.
03_Implement/test/fixtures/*.json text eol=lf
# Frozen CPU-search evaluation inputs are identified by Git blob SHA: keep LF on every checkout.
03_Implement/scripts/cpu-search-eval/queries.test*.json text eol=lf
03_Implement/scripts/cpu-search-eval/dictionary.json text eol=lf
