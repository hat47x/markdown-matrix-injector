{
  "name": "markdown-matrix-injector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --import tsx --test ./test/*.test.ts",
    "test:e2e": "npm run build && bash ./scripts/run-vscode-e2e.sh",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0",
    "@vscode/test-electron": "^2.5.2",
    "@types/vscode": "^1.96.0"
  },
  "main": "./dist/src/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onCommand:markdownMatrixInjector.renderEmbedForTest"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownMatrixInjector.renderEmbedForTest",
        "title": "MMI: Render Embed For Test"
      }
    ]
  }
}
