{
  "name": "markdown-matrix-injector",
  "displayName": "Markdown Matrix Injector (MMI)",
  "description": "Declarative, read-only table references from Markdown to Excel/CSV/XML — a governance boundary between source-of-truth data and text documents",
  "version": "0.1.0",
  "publisher": "hat47x",
  "license": "MIT",
  "type": "module",
  "icon": "media/mmi-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hat47x/markdown-matrix-injector"
  },
  "bugs": {
    "url": "https://github.com/hat47x/markdown-matrix-injector/issues"
  },
  "homepage": "https://github.com/hat47x/markdown-matrix-injector#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "excel",
    "csv",
    "table",
    "embed",
    "reference",
    "read-only",
    "governance",
    "sier",
    "documentation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:product": "tsc -p tsconfig.product.json",
    "mmi": "node --import tsx src/cli/mmi.ts",
    "test:unit": "node --import tsx --test ./test/*.test.ts",
    "test:review-route-evaluation-pipeline": "node --import tsx --test ./test/worksheetReviewRouteEvaluationPipeline.test.ts",
    "qualify:review-route-evaluation-pipeline": "npm run build && npm run test:review-route-evaluation-pipeline",
    "eval:cpu-search": "node --import tsx scripts/cpu-search-eval/evaluate.ts",
    "eval:cpu-search:scale": "node --import tsx scripts/cpu-search-eval/scale.ts",
    "eval:cpu-search:test4:first": "node --import tsx scripts/cpu-search-eval/test4-first-run.ts",
    "eval:cpu-search:test5:first": "node --import tsx scripts/cpu-search-eval/test5-first-run.ts",
    "eval:cpu-search:test6:first": "node --import tsx scripts/cpu-search-eval/test6-first-run.ts",
    "eval:import-assist": "node --import tsx scripts/import-assist-eval/evaluate.ts",
    "bench:workbook-load": "node --import tsx scripts/workbook-load-benchmark.ts",
    "test:phase9-sync": "python3 ../01_Plans/tools/check_phase9_template_sync.py",
    "test:phase9-guide-sync": "python3 ../01_Plans/tools/generate_phase9_pattern_guide.py --check",
    "test:e2e": "npm run build && bash ./scripts/run-vscode-e2e.sh",
    "test:e2e:practical": "npm run build && node --import tsx ./test/e2e/runPractical.ts",
    "test:e2e:coauthoring": "npm run build && node --import tsx ./test/e2e/runCoauthoring.ts",
    "test:e2e:import": "npm run build && node --import tsx ./test/e2e/runImport.ts",
    "test": "npm run test:unit && npm run test:candidate-review-product-baseline && npm run test:cli-distribution && npm run test:phase9-sync && npm run test:phase9-guide-sync",
    "test:cli-distribution": "node --test ./test/cliDistribution.test.mjs",
    "package:cli": "npm run build:product && node scripts/build-cli-package.mjs",
    "verify:cli-package": "node scripts/verify-cli-package.mjs",
    "release:gate": "python3 ../01_Plans/tools/release_gate_check.py --repo-root .. --format json",
    "release:gate:artifacts": "python3 ../01_Plans/tools/release_gate_check.py --repo-root .. --format json --output-file artifacts/release-gate.json --output-markdown-file artifacts/release-gate.md",
    "release:gate:full": "npm run release:gate:clean && npm run release:gate:artifacts && python3 ../01_Plans/tools/release_gate_metrics.py --input-file ../artifacts/release-gate.json --output-file ../artifacts/release-gate-metrics.csv && npm run docs:phase7-rollup && npm run release:gate:assert",
    "release:gate:clean": "python3 ../01_Plans/tools/release_gate_clean.py --repo-root ..",
    "test:release-gate-tools": "python3 ../01_Plans/tools/test_release_gate_check.py && python3 ../01_Plans/tools/test_release_gate_metrics.py && python3 ../01_Plans/tools/test_release_gate_clean.py && python3 ../01_Plans/tools/test_phase7_issue_rollup.py && python3 ../01_Plans/tools/test_release_gate_assert_artifacts.py",
    "docs:phase7-rollup": "python3 ../01_Plans/tools/phase7_issue_rollup.py --repo-root .. --output-file artifacts/phase7-issue-rollup.md",
    "release:gate:assert": "python3 ../01_Plans/tools/release_gate_assert_artifacts.py --repo-root ..",
    "package": "vsce package",
    "publish": "vsce publish",
    "eval:product-baseline": "node --import tsx scripts/product-baseline-eval/evaluate.ts",
    "eval:candidate-review-product-baseline": "node scripts/candidate-review-product-baseline.mjs",
    "test:candidate-review-product-baseline": "node --test ./test/candidateReviewProductBaseline.test.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "test:cli-bundle": "node scripts/smoke-cli-bundle.mjs"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "saxes": "6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "esbuild": "^0.27.4"
  },
  "main": "./dist/src/extension.js",
  "bin": {
    "mmi": "./dist/src/cli/bootstrap.js"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onUri",
    "onCommand:markdownMatrixInjector.renderEmbedForTest",
    "onCommand:markdownMatrixInjector.generateDeliveryManifest",
    "onCommand:markdownMatrixInjector.openSource",
    "onCommand:markdownMatrixInjector.showSourceImpact",
    "onCommand:markdownMatrixInjector.insertEmbedFromPaste",
    "onCommand:markdownMatrixInjector.insertEmbedFromDrop",
    "onCommand:markdownMatrixInjector.insertEmbedByContentMatch",
    "onCommand:markdownMatrixInjector.authorEmbed",
    "onCommand:markdownMatrixInjector.findEmbedByDescription",
    "onCommand:markdownMatrixInjector.selectLocalSemanticModel",
    "onCommand:markdownMatrixInjector.clearSearchIndex",
    "onCommand:markdownMatrixInjector.refreshLinkedPreviews",
    "onCommand:markdownMatrixInjector.searchObservation.clear",
    "onCommand:markdownMatrixInjector.searchObservation.export",
    "onCommand:markdownMatrixInjector.searchObservation.summary",
    "onCommand:markdownMatrixInjector.importFromWorkbook",
    "onCommand:markdownMatrixInjector.reviewCandidates",
    "onCommand:markdownMatrixInjector.reviewHierarchyCandidates",
    "onView:markdownMatrixInjector.tableCatalog",
    "onLanguage:markdown",
    "onCommand:markdownMatrixInjector.reviewTabularHierarchyCandidates",
    "onCommand:markdownMatrixInjector.catalog.authorFromSheet"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/markdown-matrix.css"
    ],
    "commands": [
      {
        "command": "markdownMatrixInjector.renderEmbedForTest",
        "title": "%mmi.command.renderEmbedForTest%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.generateDeliveryManifest",
        "title": "%mmi.command.generateDeliveryManifest%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.openSource",
        "title": "%mmi.command.openSource%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.showSourceImpact",
        "title": "%mmi.command.showSourceImpact%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.insertEmbedFromPaste",
        "title": "%mmi.command.insertEmbedFromPaste%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.insertEmbedFromDrop",
        "title": "%mmi.command.insertEmbedFromDrop%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.insertEmbedByContentMatch",
        "title": "%mmi.command.insertEmbedByContentMatch%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.authorEmbed",
        "title": "%mmi.command.authorEmbed%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.findEmbedByDescription",
        "title": "%mmi.command.findEmbedByDescription%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.selectLocalSemanticModel",
        "title": "%mmi.command.selectLocalSemanticModel%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.clearSearchIndex",
        "title": "%mmi.command.clearSearchIndex%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.refreshLinkedPreviews",
        "title": "%mmi.command.refreshLinkedPreviews%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.searchObservation.summary",
        "title": "%mmi.command.searchObservationSummary%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.searchObservation.export",
        "title": "%mmi.command.searchObservationExport%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.searchObservation.clear",
        "title": "%mmi.command.searchObservationClear%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.importFromWorkbook",
        "title": "%mmi.command.importFromWorkbook%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.reviewCandidates",
        "title": "%mmi.command.reviewCandidates%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.reviewHierarchyCandidates",
        "title": "%mmi.command.reviewHierarchyCandidates%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.reviewTabularHierarchyCandidates",
        "title": "%mmi.command.reviewTabularHierarchyCandidates%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.catalog.refresh",
        "title": "%mmi.command.catalog.refresh%",
        "category": "MMI",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownMatrixInjector.catalog.authorFromSheet",
        "title": "%mmi.command.catalog.authorFromSheet%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.catalog.insertTable",
        "title": "%mmi.command.catalog.insertTable%",
        "category": "MMI",
        "icon": "$(insert)"
      },
      {
        "command": "markdownMatrixInjector.catalog.selectFromTable",
        "title": "%mmi.command.catalog.selectFromTable%",
        "category": "MMI",
        "icon": "$(filter)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "markdownMatrixInjector.tableCatalog",
          "name": "%mmi.view.tableCatalog%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "markdownMatrixInjector.catalog.refresh",
          "when": "view == markdownMatrixInjector.tableCatalog",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownMatrixInjector.catalog.authorFromSheet",
          "when": "view == markdownMatrixInjector.tableCatalog && viewItem == mmiSheet",
          "group": "navigation@1"
        },
        {
          "command": "markdownMatrixInjector.catalog.insertTable",
          "when": "view == markdownMatrixInjector.tableCatalog && viewItem == mmiTable",
          "group": "inline@1"
        },
        {
          "command": "markdownMatrixInjector.catalog.selectFromTable",
          "when": "view == markdownMatrixInjector.tableCatalog && viewItem == mmiTable",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownMatrixInjector.showSourceImpact",
          "when": "false"
        },
        {
          "command": "markdownMatrixInjector.catalog.authorFromSheet",
          "when": "false"
        },
        {
          "command": "markdownMatrixInjector.catalog.insertTable",
          "when": "false"
        },
        {
          "command": "markdownMatrixInjector.catalog.selectFromTable",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownMatrixInjector.showSourceImpact",
          "when": "resourceExtname =~ /^\\.(xlsx|xlsm|xls|csv|xml|json|ya?ml|txt|text|log)$/i",
          "group": "mmi@1"
        },
        {
          "command": "markdownMatrixInjector.importFromWorkbook",
          "when": "resourceExtname =~ /^\\.(xlsx|xlsm|xls|xml)$/i",
          "group": "mmi@1"
        },
        {
          "command": "markdownMatrixInjector.reviewCandidates",
          "when": "resourceExtname =~ /^\\.(xlsx|xlsm|xls|csv|xml|json|ya?ml|txt|text|log)$/i",
          "group": "mmi@2"
        },
        {
          "command": "markdownMatrixInjector.reviewHierarchyCandidates",
          "when": "resourceExtname =~ /^\\.xml$/i",
          "group": "mmi@3"
        },
        {
          "command": "markdownMatrixInjector.reviewTabularHierarchyCandidates",
          "when": "resourceExtname =~ /^\\.(xlsx|xlsm|xls|csv)$/i",
          "group": "mmi@2"
        }
      ],
      "editor/context": [
        {
          "command": "markdownMatrixInjector.authorEmbed",
          "when": "editorLangId == markdown",
          "group": "mmi@1"
        },
        {
          "command": "markdownMatrixInjector.findEmbedByDescription",
          "when": "editorLangId == markdown",
          "group": "mmi@2"
        },
        {
          "command": "markdownMatrixInjector.insertEmbedByContentMatch",
          "when": "editorLangId == markdown",
          "group": "mmi@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownMatrixInjector.authorEmbed",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "walkthroughs": [
      {
        "id": "mmi.gettingStarted",
        "title": "%mmi.walkthrough.title%",
        "description": "%mmi.walkthrough.description%",
        "steps": [
          {
            "id": "mmi.gettingStarted.write",
            "title": "%mmi.walkthrough.write.title%",
            "description": "%mmi.walkthrough.write.description%",
            "media": {
              "markdown": "media/walkthrough/write.md"
            },
            "completionEvents": [
              "onLanguage:markdown"
            ]
          },
          {
            "id": "mmi.gettingStarted.author",
            "title": "%mmi.walkthrough.author.title%",
            "description": "%mmi.walkthrough.author.description%",
            "media": {
              "markdown": "media/walkthrough/author.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.authorEmbed"
            ]
          },
          {
            "id": "mmi.gettingStarted.find",
            "title": "%mmi.walkthrough.find.title%",
            "description": "%mmi.walkthrough.find.description%",
            "media": {
              "markdown": "media/walkthrough/find.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.findEmbedByDescription"
            ]
          },
          {
            "id": "mmi.gettingStarted.check",
            "title": "%mmi.walkthrough.check.title%",
            "description": "%mmi.walkthrough.check.description%",
            "media": {
              "markdown": "media/walkthrough/check.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.authorEmbed"
            ]
          },
          {
            "id": "mmi.gettingStarted.paste",
            "title": "%mmi.walkthrough.paste.title%",
            "description": "%mmi.walkthrough.paste.description%",
            "media": {
              "markdown": "media/walkthrough/paste.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.insertEmbedByContentMatch"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Markdown Matrix Injector",
      "properties": {
        "markdownMatrixInjector.diagnostics.whileTyping": {
          "type": "string",
          "enum": [
            "quiet",
            "full"
          ],
          "default": "quiet",
          "markdownDescription": "%mmi.setting.diagnosticsWhileTyping%"
        },
        "markdownMatrixInjector.paste.useClipboardSource": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%mmi.setting.useClipboardSource%"
        },
        "markdownMatrixInjector.search.semantic.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%mmi.setting.semanticEnabled%"
        },
        "markdownMatrixInjector.search.semantic.api": {
          "type": "string",
          "enum": [
            "ollama",
            "openai-compatible"
          ],
          "default": "ollama",
          "markdownDescription": "%mmi.setting.semanticApi%"
        },
        "markdownMatrixInjector.search.semantic.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "markdownDescription": "%mmi.setting.semanticEndpoint%"
        },
        "markdownMatrixInjector.search.semantic.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%mmi.setting.semanticModel%"
        },
        "markdownMatrixInjector.search.semantic.artifactDigest": {
          "type": "string",
          "default": "",
          "markdownDescription": "%mmi.setting.semanticArtifactDigest%"
        },
        "markdownMatrixInjector.search.aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%mmi.setting.searchAliases%"
        },
        "markdownMatrixInjector.search.observation.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%mmi.setting.searchObservationEnabled%"
        },
        "markdownMatrixInjector.search.observation.includeText": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%mmi.setting.searchObservationIncludeText%"
        },
        "markdownMatrixInjector.search.semantic.minScore": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "%mmi.setting.semanticMinScore%"
        },
        "markdownMatrixInjector.search.semantic.queryPrefix": {
          "type": "string",
          "default": "",
          "markdownDescription": "%mmi.setting.semanticQueryPrefix%"
        },
        "markdownMatrixInjector.search.semantic.documentPrefix": {
          "type": "string",
          "default": "",
          "markdownDescription": "%mmi.setting.semanticDocumentPrefix%"
        },
        "markdownMatrixInjector.reviewObservation.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%mmi.setting.reviewObservation%"
        }
      }
    }
  }
}
