{
  "name": "markdown-matrix-injector",
  "displayName": "Markdown Matrix Injector (MMI)",
  "description": "Declarative, read-only table references from Markdown to Excel/CSV/XML — a governance boundary between source-of-truth data and text documents",
  "version": "0.1.0",
  "publisher": "hat47x",
  "license": "MIT",
  "type": "module",
  "icon": "media/mmi-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hat47x/markdown-matrix-injector"
  },
  "bugs": {
    "url": "https://github.com/hat47x/markdown-matrix-injector/issues"
  },
  "homepage": "https://github.com/hat47x/markdown-matrix-injector#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "excel",
    "csv",
    "table",
    "embed",
    "reference",
    "read-only",
    "governance",
    "sier",
    "documentation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --import tsx --test ./test/*.test.ts",
    "test:review-route-evaluation-pipeline": "node --import tsx --test ./test/worksheetReviewRouteEvaluationPipeline.test.ts",
    "qualify:review-route-evaluation-pipeline": "npm run build && npm run test:review-route-evaluation-pipeline",
    "eval:cpu-search": "node --import tsx scripts/cpu-search-eval/evaluate.ts",
    "eval:cpu-search:scale": "node --import tsx scripts/cpu-search-eval/scale.ts",
    "test:phase9-sync": "python3 ../01_Plans/tools/check_phase9_template_sync.py",
    "test:phase9-guide-sync": "python3 ../01_Plans/tools/generate_phase9_pattern_guide.py --check",
    "test:e2e": "npm run build && bash ./scripts/run-vscode-e2e.sh",
    "test:e2e:practical": "npm run build && node --import tsx ./test/e2e/runPractical.ts",
    "test": "npm run test:unit && npm run test:phase9-sync && npm run test:phase9-guide-sync",
    "release:gate": "python3 ../01_Plans/tools/release_gate_check.py --repo-root .. --format json",
    "release:gate:artifacts": "python3 ../01_Plans/tools/release_gate_check.py --repo-root .. --format json --output-file artifacts/release-gate.json --output-markdown-file artifacts/release-gate.md",
    "release:gate:full": "npm run release:gate:clean && npm run release:gate:artifacts && python3 ../01_Plans/tools/release_gate_metrics.py --input-file ../artifacts/release-gate.json --output-file ../artifacts/release-gate-metrics.csv && npm run docs:phase7-rollup && npm run release:gate:assert",
    "release:gate:clean": "python3 ../01_Plans/tools/release_gate_clean.py --repo-root ..",
    "test:release-gate-tools": "python3 ../01_Plans/tools/test_release_gate_check.py && python3 ../01_Plans/tools/test_release_gate_metrics.py && python3 ../01_Plans/tools/test_release_gate_clean.py && python3 ../01_Plans/tools/test_phase7_issue_rollup.py && python3 ../01_Plans/tools/test_release_gate_assert_artifacts.py",
    "docs:phase7-rollup": "python3 ../01_Plans/tools/phase7_issue_rollup.py --repo-root .. --output-file artifacts/phase7-issue-rollup.md",
    "release:gate:assert": "python3 ../01_Plans/tools/release_gate_assert_artifacts.py --repo-root ..",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "main": "./dist/src/extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onUri",
    "onCommand:markdownMatrixInjector.renderEmbedForTest",
    "onCommand:markdownMatrixInjector.generateDeliveryManifest",
    "onCommand:markdownMatrixInjector.openSource",
    "onCommand:markdownMatrixInjector.insertEmbedFromPaste",
    "onCommand:markdownMatrixInjector.insertEmbedFromDrop",
    "onCommand:markdownMatrixInjector.insertEmbedByContentMatch",
    "onCommand:markdownMatrixInjector.authorEmbed",
    "onCommand:markdownMatrixInjector.findEmbedByDescription",
    "onCommand:markdownMatrixInjector.clearSearchIndex",
    "onLanguage:markdown"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/markdown-matrix.css"
    ],
    "commands": [
      {
        "command": "markdownMatrixInjector.renderEmbedForTest",
        "title": "%mmi.command.renderEmbedForTest%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.generateDeliveryManifest",
        "title": "%mmi.command.generateDeliveryManifest%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.openSource",
        "title": "%mmi.command.openSource%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.insertEmbedFromPaste",
        "title": "%mmi.command.insertEmbedFromPaste%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.insertEmbedFromDrop",
        "title": "%mmi.command.insertEmbedFromDrop%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.insertEmbedByContentMatch",
        "title": "%mmi.command.insertEmbedByContentMatch%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.authorEmbed",
        "title": "%mmi.command.authorEmbed%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.findEmbedByDescription",
        "title": "%mmi.command.findEmbedByDescription%",
        "category": "MMI"
      },
      {
        "command": "markdownMatrixInjector.clearSearchIndex",
        "title": "%mmi.command.clearSearchIndex%",
        "category": "MMI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownMatrixInjector.authorEmbed",
          "when": "editorLangId == markdown",
          "group": "mmi@1"
        },
        {
          "command": "markdownMatrixInjector.findEmbedByDescription",
          "when": "editorLangId == markdown",
          "group": "mmi@2"
        },
        {
          "command": "markdownMatrixInjector.insertEmbedByContentMatch",
          "when": "editorLangId == markdown",
          "group": "mmi@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownMatrixInjector.authorEmbed",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "walkthroughs": [
      {
        "id": "mmi.gettingStarted",
        "title": "%mmi.walkthrough.title%",
        "description": "%mmi.walkthrough.description%",
        "steps": [
          {
            "id": "mmi.gettingStarted.write",
            "title": "%mmi.walkthrough.write.title%",
            "description": "%mmi.walkthrough.write.description%",
            "media": {
              "markdown": "media/walkthrough/write.md"
            },
            "completionEvents": [
              "onLanguage:markdown"
            ]
          },
          {
            "id": "mmi.gettingStarted.author",
            "title": "%mmi.walkthrough.author.title%",
            "description": "%mmi.walkthrough.author.description%",
            "media": {
              "markdown": "media/walkthrough/author.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.authorEmbed"
            ]
          },
          {
            "id": "mmi.gettingStarted.find",
            "title": "%mmi.walkthrough.find.title%",
            "description": "%mmi.walkthrough.find.description%",
            "media": {
              "markdown": "media/walkthrough/find.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.findEmbedByDescription"
            ]
          },
          {
            "id": "mmi.gettingStarted.check",
            "title": "%mmi.walkthrough.check.title%",
            "description": "%mmi.walkthrough.check.description%",
            "media": {
              "markdown": "media/walkthrough/check.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.authorEmbed"
            ]
          },
          {
            "id": "mmi.gettingStarted.paste",
            "title": "%mmi.walkthrough.paste.title%",
            "description": "%mmi.walkthrough.paste.description%",
            "media": {
              "markdown": "media/walkthrough/paste.md"
            },
            "completionEvents": [
              "onCommand:markdownMatrixInjector.insertEmbedByContentMatch"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Markdown Matrix Injector",
      "properties": {
        "markdownMatrixInjector.paste.useClipboardSource": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%mmi.setting.useClipboardSource%"
        }
      }
    }
  }
}
